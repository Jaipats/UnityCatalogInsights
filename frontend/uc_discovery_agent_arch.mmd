%%{init: {
  "theme": "base",
  "themeVariables": {
    "primaryColor": "#2B6CB0",
    "primaryTextColor": "#FFFFFF",
    "primaryBorderColor": "#1A365D",
    "lineColor": "#4A6FA5",
    "background": "#FFFEF5",
    "clusterBkg": "#FFFEF5",
    "clusterBorder": "#CBD5E0",
    "edgeLabelBackground": "#FFFEF5",
    "fontFamily": "Segoe UI, Helvetica, Arial, sans-serif",
    "fontSize": "13px"
  }
}}%%
graph TD

  %% ── USER ──
  USER(["End User / Browser"])

  %% ── APP LAYER ──
  subgraph APP["Databricks App"]
    PROXY["Apps Proxy\nSSO + OBO Token"]
    UI["Chat UI"]
    API["API Endpoints\n/chat · /tables · /me"]
  end

  USER --> PROXY
  PROXY --> UI
  UI --> API

  %% ── QUERY ORCHESTRATION ──
  API --> ACL

  subgraph QUERY["Query Flow"]
    ACL{{"ACL Filter\n(per-table SHOW GRANTS)"}}
    VS["1. Vector Search\nSemantic Retrieval\nSP Token"]
    SQL["2. SHOW GRANTS per table\nACL Check via SQL DW\nSP Token"]
    LLM["3. Foundation Model API\nClaude Sonnet 4\nSP Token"]
  end

  ACL --> VS
  ACL --> SQL
  VS --> ACL
  SQL --> ACL
  ACL --> LLM
  LLM --> API

  %% ── DATA PIPELINE ──
  subgraph PIPELINE["Data Pipeline — Offline"]
    UC[("UC Metadata\nCatalog · Schema\nTable · Column\nComments · Tags · ACLs")]
    NB["Extraction Notebook\nServerless · No LLM"]
    DELTA[("Delta Table\nuc_metadata_documents\nChange Data Feed")]
    VSIDX["VS Index\nDelta Sync + BGE Embeddings"]
  end

  UC --> NB --> DELTA --> VSIDX
  VSIDX -.-> VS

  %% ── STYLES ──
  classDef user     fill:#1A365D,stroke:#0F2548,color:#FFF,font-weight:bold
  classDef app      fill:#2B6CB0,stroke:#1A365D,color:#FFF
  classDef acl      fill:#9B2C2C,stroke:#742A2A,color:#FFF,font-weight:bold
  classDef vs       fill:#553C9A,stroke:#44337A,color:#FFF
  classDef sql      fill:#B7791F,stroke:#975A16,color:#FFF,font-weight:bold
  classDef llm      fill:#C05621,stroke:#9C4221,color:#FFF,font-weight:bold
  classDef uc       fill:#276749,stroke:#1C4532,color:#FFF
  classDef nb       fill:#2F855A,stroke:#276749,color:#FFF
  classDef delta    fill:#285E61,stroke:#1D4044,color:#FFF
  classDef vsidx    fill:#553C9A,stroke:#44337A,color:#FFF

  class USER user
  class PROXY,UI,API app
  class ACL acl
  class VS vsidx
  class SQL sql
  class LLM llm
  class UC uc
  class NB nb
  class DELTA delta
  class VSIDX vsidx

  style APP      fill:#EBF4FF,stroke:#2B6CB0,stroke-width:2px,color:#1A365D
  style QUERY    fill:#FFF5F5,stroke:#E53E3E,stroke-width:2px,color:#742A2A
  style PIPELINE fill:#F0FFF4,stroke:#38A169,stroke-width:2px,color:#1B4332
